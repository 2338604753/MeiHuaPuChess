<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====== 竹青翠微 ====== -->
    <Color x:Key="AccentIndigo">#166534</Color>
    <Color x:Key="AccentEmerald">#15803D</Color>
    <Color x:Key="AccentAmber">#CA8A04</Color>
    <Color x:Key="AccentViolet">#047857</Color>
    <Color x:Key="AccentRose">#B91C1C</Color>
    <Color x:Key="AccentTeal">#0F766E</Color>
    <Color x:Key="AccentSky">#0369A1</Color>

    <SolidColorBrush x:Key="IndigoBrush" Color="#166534"/>
    <SolidColorBrush x:Key="EmeraldBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#CA8A04"/>
    <SolidColorBrush x:Key="VioletBrush" Color="#047857"/>
    <SolidColorBrush x:Key="RoseBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="TealBrush" Color="#0F766E"/>
    <SolidColorBrush x:Key="SkyBrush" Color="#0369A1"/>

    <SolidColorBrush x:Key="WindowBgBrush" Color="#F0F4F0"/>
    <SolidColorBrush x:Key="BoardFrameBrush" Color="#1C3320"/>
    <Color x:Key="TextPrimaryColor">#152016</Color>
    <Color x:Key="TextSecondaryColor">#6B7A6C</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#152016"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7A6C"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#DCE5DD"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="#152016"/>

</ResourceDictionary>
