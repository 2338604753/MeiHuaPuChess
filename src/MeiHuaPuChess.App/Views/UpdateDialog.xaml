<Window x:Class="MeiHuaPuChess.App.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新" Width="420" Height="340"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="White" ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="White" CornerRadius="12" BorderBrush="#E7E5E4" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold"
                           Foreground="#1C1917" VerticalAlignment="Center"/>
                <Button Content="✕" Background="Transparent" BorderThickness="0"
                        Foreground="#A8A29E" FontSize="16" Cursor="Hand"
                        HorizontalAlignment="Right" Click="OnCloseClick"
                        Width="32" Height="32" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- 内容区 -->
            <StackPanel Grid.Row="1">
                <!-- 已是最新 -->
                <StackPanel x:Name="LatestPanel" Visibility="Collapsed">
                    <TextBlock Text="✅" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="已是最新版本" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="#059669"/>
                    <TextBlock x:Name="CurrentVersionLabel" FontSize="13"
                               HorizontalAlignment="Center" Foreground="#78716C" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- 发现新版本 -->
                <StackPanel x:Name="UpdatePanel" Visibility="Collapsed">
                    <TextBlock Text="🎉" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="发现新版本！" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="#D97706"/>
                    <Border Background="#FFFBEB" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="OldVersionLabel" FontSize="13"
                                           Foreground="#78716C" TextDecorations="Strikethrough"/>
                                <TextBlock Text=" → " FontSize="13" Foreground="#A8A29E" Margin="4,0"/>
                                <TextBlock x:Name="NewVersionLabel" FontSize="14" FontWeight="Bold"
                                           Foreground="#D97706"/>
                            </StackPanel>
                            <TextBlock x:Name="ReleaseNameLabel" FontSize="13"
                                       HorizontalAlignment="Center" Foreground="#1C1917"
                                       FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 错误 -->
                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                    <TextBlock Text="⚠" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock x:Name="ErrorText" FontSize="14"
                               HorizontalAlignment="Center" Foreground="#DC2626"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- 操作按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="DownloadBtn" Content="下载更新" Width="120" Height="38"
                        FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                        Foreground="White" Background="#D97706"
                        Visibility="Collapsed" Click="OnDownloadClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="16,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="关闭" Width="80" Height="38"
                        FontSize="14" Cursor="Hand"
                        Foreground="#78716C" Background="#F5F5F4"
                        Margin="8,0,0,0" Click="OnCloseClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
