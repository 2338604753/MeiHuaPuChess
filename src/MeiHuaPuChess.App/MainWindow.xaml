<Window x:Class="MeiHuaPuChess.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MeiHuaPuChess.App.Views"
        xmlns:converters="clr-namespace:MeiHuaPuChess.App.Converters"
        xmlns:models="clr-namespace:MeiHuaPuChess.Core.Models;assembly=MeiHuaPuChess.Core"
        mc:Ignorable="d"
        Title="梅花谱象棋"
        Icon="Resources/app.ico"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F3F0EB">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:SideToColorConverter x:Key="SideToColor"/>

        <!-- ================================================================
             颜色常量
        ================================================================ -->
        <SolidColorBrush x:Key="TextPrimary" Color="#1E1B18"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#78716C"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A8A29E"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E7E5E4"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#4F46E5"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#4338CA"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#059669"/>
        <SolidColorBrush x:Key="SuccessHoverColor" Color="#047857"/>
        <SolidColorBrush x:Key="DangerColor" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerHoverColor" Color="#B91C1C"/>
        <SolidColorBrush x:Key="WarningColor" Color="#D97706"/>
        <SolidColorBrush x:Key="InfoColor" Color="#2563EB"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.08" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow" BlurRadius="4" ShadowDepth="1"
                          Direction="270" Opacity="0.15" Color="#000000"/>

        <!-- ================================================================
             卡片容器样式
        ================================================================ -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- ================================================================
             章节标题
        ================================================================ -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ================================================================
             基础按钮模板
        ================================================================ -->
        <ControlTemplate x:Key="BtnTemplate" TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    Effect="{StaticResource BtnShadow}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 按钮变体 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource DangerColor}"/>
        </Style>

        <!-- 导航按钮（小尺寸） -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
        </Style>

        <!-- 普通操作按钮 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
        </Style>

        <!-- ================================================================
             模式切换 ToggleButton（分段控件）
        ================================================================ -->
        <Style x:Key="ModeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="bg">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F5F5F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================================
             ComboBox 样式
        ================================================================ -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#FAFAF9"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource CardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Cursor="Hand">
                                            <Grid>
                                                <ContentPresenter Margin="12,0,30,0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBox}, Path=SelectionBoxItem}"/>
                                                <Path x:Name="arrow" Data="M0,0 L4,4 L8,0"
                                                      Stroke="#78716C" StrokeThickness="1.5"
                                                      HorizontalAlignment="Right" Margin="0,0,12,0"
                                                      Width="10" Height="6" Stretch="Fill"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#D6D3D1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        Background="White"
                                        CornerRadius="10"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.12"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="320">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Height" Value="38"/>
                        <Setter Property="Padding" Value="14,0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="itemBorder"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="6" Margin="4,1">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="#F5F5F4"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="#EEF2FF"/>
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================================
             走棋记录 ItemTemplate
        ================================================================ -->
        <DataTemplate x:Key="MoveItemTemplate" DataType="{x:Type models:MoveViewModel}">
            <Border Padding="8,4" CornerRadius="6" Margin="2,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentStep}" Value="True">
                                <Setter Property="Background" Value="#EEF2FF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 当前步指示圆点 -->
                    <Ellipse Grid.Column="0" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentStep}" Value="True">
                                        <Setter Property="Fill" Value="#4F46E5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" FontSize="13" FontFamily="KaiTi, SimSun, Consolas"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding DisplayText}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentStep}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#4338CA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="560"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧：棋盘区域 ===== -->
        <Border Grid.Column="0" Margin="16" Background="#292524"
                CornerRadius="12" Padding="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
            </Border.Effect>
            <Border Margin="10" Background="#EED8B0" CornerRadius="6">
                <views:ChessBoardView x:Name="ChessBoard" Margin="6"
                                      IsReadOnly="{Binding IsBoardReadOnly}"/>
            </Border>
        </Border>

        <!-- ===== 右侧：控制面板 ===== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Padding="0,20,20,20">
            <StackPanel>

                <!-- ===== 模式切换 ===== -->
                <TextBlock Text="模式选择" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource CardStyle}" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#F5F5F4" CornerRadius="8">
                            <ToggleButton Grid.Column="0" Content="全局观看"
                                          IsChecked="{Binding IsReviewMode, Mode=OneWay}"
                                          Command="{Binding SwitchToReviewModeCommand}"
                                          Style="{StaticResource ModeToggleStyle}"/>
                        </Border>
                        <ToggleButton Grid.Column="1" Content="训练模式"
                                      IsChecked="{Binding IsTrainingMode, Mode=OneWay}"
                                      Command="{Binding SwitchToTrainingModeCommand}"
                                      Style="{StaticResource ModeToggleStyle}"/>
                    </Grid>
                </Border>

                <!-- ===== 棋局选择 ===== -->
                <TextBlock Text="棋局选择" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding Records}"
                                  SelectedItem="{Binding SelectedRecord}"
                                  Style="{StaticResource ModernComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryColor}"
                                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding SelectedRecord.Description, TargetNullValue=''}"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   MaxHeight="48" TextTrimming="CharacterEllipsis"/>

                        <!-- 开始按钮 -->
                        <Button Margin="0,14,0,0" Style="{StaticResource SuccessButton}"
                                Command="{Binding StartReviewCommand}"
                                Visibility="{Binding IsReviewMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="开始观看" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="0,14,0,0" Style="{StaticResource DangerButton}"
                                Command="{Binding StartTrainingCommand}"
                                Visibility="{Binding IsTrainingMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="开始练习" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ===== 当前进度 ===== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"
                                   Text="{Binding StepProgress}"/>
                        <TextBlock FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"
                                   Text="{Binding GameStatus}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="14" Foreground="{StaticResource DangerColor}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Text="{Binding CurrentSide}" Margin="0,6,0,0"/>
                        <!-- 训练完成提示 -->
                        <Border Background="#ECFDF5" CornerRadius="8" Padding="10,6" Margin="0,8,0,0"
                                Visibility="{Binding IsTrainingComplete, Converter={StaticResource BoolToVis}}"
                                BorderBrush="#A7F3D0" BorderThickness="1">
                            <TextBlock Text="训练完成！切到「全局观看」回顾棋谱"
                                       FontSize="13" Foreground="#065F46"
                                       HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== Review 模式：导航按钮 ===== -->
                <StackPanel Visibility="{Binding IsReviewMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="棋谱导航" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <!-- 第一行：导航按钮 -->
                            <UniformGrid Columns="4" Rows="1">
                                <Button Content="⏮" ToolTip="最前"
                                        Style="{StaticResource NavButtonStyle}"
                                        Command="{Binding GoToFirstCommand}"/>
                                <Button Content="◀" ToolTip="上一步"
                                        Style="{StaticResource NavButtonStyle}"
                                        Command="{Binding PreviousStepCommand}"
                                        IsEnabled="{Binding CanGoPrevious}"/>
                                <Button Content="▶" ToolTip="下一步"
                                        Style="{StaticResource NavButtonStyle}"
                                        Command="{Binding NextStepCommand}"
                                        IsEnabled="{Binding CanGoForward}"/>
                                <Button Content="⏭" ToolTip="最后"
                                        Style="{StaticResource NavButtonStyle}"
                                        Command="{Binding GoToLastCommand}"/>
                            </UniformGrid>

                            <!-- 第二行：自动播放 -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Button Content="{Binding AutoPlayButtonText}"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ToggleAutoPlayCommand}"
                                        Width="100" Height="36" FontSize="13"/>
                                <TextBlock Text="速度(秒)"
                                           VerticalAlignment="Center" Margin="10,0,4,0"
                                           Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                <TextBox Text="{Binding AutoPlaySpeed, UpdateSourceTrigger=PropertyChanged}"
                                         Width="44" Height="32" TextAlignment="Center"
                                         FontSize="13" VerticalContentAlignment="Center"
                                         BorderBrush="{StaticResource CardBorder}"
                                         Background="#FAFAF9" BorderThickness="1"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Training 模式：提示区域 ===== -->
                <StackPanel Visibility="{Binding IsTrainingMode, Converter={StaticResource BoolToVis}}">
                    <!-- 错误 / 提示信息 -->
                    <Border CornerRadius="12" Padding="14" Margin="0,0,0,14"
                            Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFFBEB"/>
                                <Setter Property="BorderBrush" Value="#FDE68A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHintError}" Value="True">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHintError}" Value="False">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="💡"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHintError}" Value="True">
                                                <Setter Property="Text" Value="✕"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding HintMessage}"
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 训练操作按钮 -->
                    <TextBlock Text="训练操作" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Button Content="  重新开始" Style="{StaticResource ActionButton}"
                                    Command="{Binding RestartCommand}"
                                    Background="#78716C"/>
                            <Button Content="  悔棋" Style="{StaticResource ActionButton}"
                                    Command="{Binding UndoCommand}"
                                    Background="#78716C"
                                    IsEnabled="{Binding CanUndo}"/>
                            <Button Content="  显示提示" Style="{StaticResource ActionButton}"
                                    Command="{Binding ShowHintCommand}"
                                    Background="{StaticResource InfoColor}"
                                    Margin="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== 走棋记录（两种模式共用） ===== -->
                <TextBlock Text="走棋记录" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource CardStyle}" Padding="10" MaxHeight="200">
                    <ListBox ItemsSource="{Binding MoveHistoryDisplay}"
                             ItemTemplate="{StaticResource MoveItemTemplate}"
                             Background="Transparent" BorderThickness="0"
                             FontSize="13" FontFamily="KaiTi, SimSun, Consolas"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== 底部状态栏 ===== -->
        <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom"
                Background="#292524" Padding="14,8" Height="36">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="#A8A29E" FontSize="12" VerticalAlignment="Center">
                    <Run Text="{Binding CurrentSide, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="#A8A29E" FontSize="12" Margin="30,0,0,0"
                           VerticalAlignment="Center">
                    <Run Text="红吃: "/><Run Text="{Binding CapturedByRed, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="#A8A29E" FontSize="12" Margin="20,0,0,0"
                           VerticalAlignment="Center">
                    <Run Text="黑吃: "/><Run Text="{Binding CapturedByBlack, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
