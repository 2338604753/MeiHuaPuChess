<Window x:Class="MeiHuaPuChess.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MeiHuaPuChess.App.Views"
        xmlns:converters="clr-namespace:MeiHuaPuChess.App.Converters"
        xmlns:models="clr-namespace:MeiHuaPuChess.Core.Models;assembly=MeiHuaPuChess.Core"
        mc:Ignorable="d"
        Title="梅花谱象棋"
        Icon="Resources/app.ico"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F3F0EB">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:SideToColorConverter x:Key="SideToColor"/>

        <!-- ================================================================
             基础色板
        ================================================================ -->
        <SolidColorBrush x:Key="TextPrimary" Color="#1C1917"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#78716C"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A8A29E"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E7E5E4"/>

        <!-- 区域专属配色 -->
        <Color x:Key="AccentIndigo">#4F46E5</Color>
        <Color x:Key="AccentEmerald">#059669</Color>
        <Color x:Key="AccentAmber">#D97706</Color>
        <Color x:Key="AccentViolet">#7C3AED</Color>
        <Color x:Key="AccentRose">#E11D48</Color>
        <Color x:Key="AccentTeal">#0D9488</Color>
        <Color x:Key="AccentSky">#0284C7</Color>

        <SolidColorBrush x:Key="IndigoBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="EmeraldBrush" Color="#059669"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="VioletBrush" Color="#7C3AED"/>
        <SolidColorBrush x:Key="RoseBrush" Color="#E11D48"/>
        <SolidColorBrush x:Key="TealBrush" Color="#0D9488"/>
        <SolidColorBrush x:Key="SkyBrush" Color="#0284C7"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.08" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow" BlurRadius="4" ShadowDepth="1"
                          Direction="270" Opacity="0.15" Color="#000000"/>

        <!-- ================================================================
             带左侧色条的卡片
        ================================================================ -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- ================================================================
             章节标题（带彩色圆点）
        ================================================================ -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ================================================================
             按钮模板
        ================================================================ -->
        <ControlTemplate x:Key="BtnTemplate" TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    Effect="{StaticResource BtnShadow}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
        </Style>

        <Style x:Key="IndigoButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource IndigoBrush}"/>
        </Style>
        <Style x:Key="EmeraldButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource EmeraldBrush}"/>
        </Style>
        <Style x:Key="RoseButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource RoseBrush}"/>
        </Style>
        <Style x:Key="AmberButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AmberBrush}"/>
        </Style>
        <Style x:Key="SkyButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource SkyBrush}"/>
        </Style>
        <Style x:Key="SlateButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#78716C"/>
        </Style>

        <!-- 导航小按钮 -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
        </Style>

        <!-- ================================================================
             模式切换 — 两个独立彩色 ToggleButton
        ================================================================ -->
        <Style x:Key="ReviewToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#78716C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" Background="#F5F5F4" CornerRadius="8,0,0,8"
                                Padding="16,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="#D6D3D1"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="dot" Property="Fill" Value="#A5B4FC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrainToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#78716C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" Background="#F5F5F4" CornerRadius="0,8,8,0"
                                Padding="16,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="#D6D3D1"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#D97706"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="dot" Property="Fill" Value="#FDE68A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================================
             ComboBox 样式
        ================================================================ -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#FAFAF9"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource CardBorder}"
                                                BorderThickness="1" CornerRadius="8" Cursor="Hand">
                                            <Grid>
                                                <ContentPresenter Margin="12,0,30,0" VerticalAlignment="Center"
                                                                  Content="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBox}, Path=SelectionBoxItem}"/>
                                                <Path x:Name="arrow" Data="M0,0 L4,4 L8,0"
                                                      Stroke="#78716C" StrokeThickness="1.5"
                                                      HorizontalAlignment="Right" Margin="0,0,12,0"
                                                      Width="10" Height="6" Stretch="Fill"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" Focusable="False" PopupAnimation="Fade">
                                <Border Background="White" CornerRadius="10"
                                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                        Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.12"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="320">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Padding" Value="14,0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="itemBorder" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,1">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="#F5F5F4"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="#ECFDF5"/>
                                            <Setter Property="Foreground" Value="#059669"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================================
             走棋记录 ItemTemplate（红黑双方分色）
        ================================================================ -->
        <DataTemplate x:Key="MoveItemTemplate" DataType="{x:Type models:MoveViewModel}">
            <Border Padding="10,5" CornerRadius="6" Margin="0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentStep}" Value="True">
                                <Setter Property="Background" Value="#EEF2FF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 步数编号圆点 -->
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F5F5F4"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentStep}" Value="True">
                                        <Setter Property="Background" Value="#4F46E5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StepNumber}" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#A8A29E"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentStep}" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <!-- 走棋文本 -->
                    <TextBlock Grid.Column="1" FontSize="13" FontFamily="KaiTi, SimSun, Consolas"
                               VerticalAlignment="Center" Text="{Binding DisplayText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentStep}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#4338CA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="560"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧：棋盘 ===== -->
        <Border Grid.Column="0" Margin="16" Background="#292524" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25"/>
            </Border.Effect>
            <Border Margin="10" Background="#EED8B0" CornerRadius="6">
                <views:ChessBoardView x:Name="ChessBoard" Margin="6"
                                      IsReadOnly="{Binding IsBoardReadOnly}"/>
            </Border>
        </Border>

        <!-- ===== 右侧：控制面板 ===== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,20,20,20">
            <StackPanel>

                <!-- ========== 模式选择 ========== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="8" Height="8" Fill="#4F46E5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="模式选择" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" Foreground="#78716C"/>
                </StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="4">
                    <UniformGrid Columns="2" Rows="1">
                        <ToggleButton Content="全局观看"
                                      IsChecked="{Binding IsReviewMode, Mode=OneWay}"
                                      Command="{Binding SwitchToReviewModeCommand}"
                                      Style="{StaticResource ReviewToggle}"/>
                        <ToggleButton Content="训练模式"
                                      IsChecked="{Binding IsTrainingMode, Mode=OneWay}"
                                      Command="{Binding SwitchToTrainingModeCommand}"
                                      Style="{StaticResource TrainToggle}"/>
                    </UniformGrid>
                </Border>

                <!-- ========== 棋局选择 ========== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="8" Height="8" Fill="#059669" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="棋局选择" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" Foreground="#78716C"/>
                </StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding Records}"
                                  SelectedItem="{Binding SelectedRecord}"
                                  Style="{StaticResource ModernComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#ECFDF5" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="12"
                                                       Foreground="#059669"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding SelectedRecord.Description, TargetNullValue=''}"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   MaxHeight="48" TextTrimming="CharacterEllipsis"/>

                        <Button Margin="0,14,0,0" Style="{StaticResource EmeraldButton}"
                                Command="{Binding StartReviewCommand}"
                                Visibility="{Binding IsReviewMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="开始观看" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="0,14,0,0" Style="{StaticResource RoseButton}"
                                Command="{Binding StartTrainingCommand}"
                                Visibility="{Binding IsTrainingMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="开始练习" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ========== 当前进度 ========== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="8" Height="8" Fill="#D97706" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="当前进度" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" Foreground="#78716C"/>
                </StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFBEB" Offset="0"/>
                            <GradientStop Color="#FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="#D97706" Margin="0,4,0,0"
                                   Text="{Binding StepProgress}"/>
                        <TextBlock FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"
                                   Text="{Binding GameStatus}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                        <Border Background="#FFF7ED" CornerRadius="8" Padding="8,4" Margin="0,8,0,0">
                            <TextBlock FontSize="14" Foreground="#C2410C"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Text="{Binding CurrentSide}"/>
                        </Border>
                        <Border Background="#ECFDF5" CornerRadius="8" Padding="10,6" Margin="0,8,0,0"
                                Visibility="{Binding IsTrainingComplete, Converter={StaticResource BoolToVis}}"
                                BorderBrush="#A7F3D0" BorderThickness="1">
                            <TextBlock Text="训练完成！切到「全局观看」回顾棋谱"
                                       FontSize="13" Foreground="#065F46"
                                       HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ========== 棋谱导航 ========== -->
                <StackPanel Visibility="{Binding IsReviewMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse Width="8" Height="8" Fill="#7C3AED" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="棋谱导航" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#78716C"/>
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <UniformGrid Columns="4" Rows="1">
                                <Button Content="⏮" ToolTip="最前"
                                        Style="{StaticResource NavBtn}"
                                        Background="#7C3AED"
                                        Command="{Binding GoToFirstCommand}"/>
                                <Button Content="◀" ToolTip="上一步"
                                        Style="{StaticResource NavBtn}"
                                        Background="#8B5CF6"
                                        Command="{Binding PreviousStepCommand}"
                                        IsEnabled="{Binding CanGoPrevious}"/>
                                <Button Content="▶" ToolTip="下一步"
                                        Style="{StaticResource NavBtn}"
                                        Background="#8B5CF6"
                                        Command="{Binding NextStepCommand}"
                                        IsEnabled="{Binding CanGoForward}"/>
                                <Button Content="⏭" ToolTip="最后"
                                        Style="{StaticResource NavBtn}"
                                        Background="#7C3AED"
                                        Command="{Binding GoToLastCommand}"/>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Button Content="{Binding AutoPlayButtonText}"
                                        Style="{StaticResource IndigoButton}"
                                        Command="{Binding ToggleAutoPlayCommand}"
                                        Width="100" Height="36" FontSize="13"/>
                                <TextBlock Text="速度(秒)" VerticalAlignment="Center" Margin="10,0,4,0"
                                           Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                <TextBox Text="{Binding AutoPlaySpeed, UpdateSourceTrigger=PropertyChanged}"
                                         Width="44" Height="32" TextAlignment="Center"
                                         FontSize="13" VerticalContentAlignment="Center"
                                         BorderBrush="{StaticResource CardBorder}"
                                         Background="#FAFAF9" BorderThickness="1"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== 训练操作 ========== -->
                <StackPanel Visibility="{Binding IsTrainingMode, Converter={StaticResource BoolToVis}}">
                    <!-- 提示信息 -->
                    <Border CornerRadius="12" Padding="14" Margin="0,0,0,14"
                            Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFFBEB"/>
                                <Setter Property="BorderBrush" Value="#FDE68A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHintError}" Value="True">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHintError}" Value="False">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="💡"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHintError}" Value="True">
                                                <Setter Property="Text" Value="✕"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding HintMessage}" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse Width="8" Height="8" Fill="#E11D48" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="训练操作" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#78716C"/>
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Button Content="  重新开始" Style="{StaticResource SlateButton}"
                                    Command="{Binding RestartCommand}" Margin="0,0,0,6"/>
                            <Button Content="  悔棋" Style="{StaticResource AmberButton}"
                                    Command="{Binding UndoCommand}"
                                    IsEnabled="{Binding CanUndo}" Margin="0,0,0,6"/>
                            <Button Content="  显示提示" Style="{StaticResource SkyButton}"
                                    Command="{Binding ShowHintCommand}" Margin="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== 走棋记录 ========== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="8" Height="8" Fill="#0D9488" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="走棋记录" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" Foreground="#78716C"/>
                </StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="10" MaxHeight="200">
                    <ListBox ItemsSource="{Binding MoveHistoryDisplay}"
                             ItemTemplate="{StaticResource MoveItemTemplate}"
                             Background="Transparent" BorderThickness="0"
                             FontSize="13" FontFamily="KaiTi, SimSun, Consolas"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== 底部状态栏 ===== -->
        <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom"
                Background="#1C1917" Padding="16,10" Height="40">
            <StackPanel Orientation="Horizontal">
                <Border Background="#4F46E5" CornerRadius="4" Padding="8,3" Margin="0,0,16,0">
                    <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold"
                               Text="{Binding CurrentSide, Mode=OneWay}"/>
                </Border>
                <Ellipse Width="4" Height="4" Fill="#DC2626" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Foreground="#A8A29E" FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Run Text="红吃 "/><Run Text="{Binding CapturedByRed, Mode=OneWay}" FontWeight="Bold" Foreground="#FCA5A5"/>
                </TextBlock>
                <Ellipse Width="4" Height="4" Fill="#57534E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Foreground="#A8A29E" FontSize="12" VerticalAlignment="Center">
                    <Run Text="黑吃 "/><Run Text="{Binding CapturedByBlack, Mode=OneWay}" FontWeight="Bold" Foreground="#D6D3D1"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
