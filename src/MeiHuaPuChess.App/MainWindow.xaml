<Window x:Class="MeiHuaPuChess.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MeiHuaPuChess.App.Views"
        xmlns:converters="clr-namespace:MeiHuaPuChess.App.Converters"
        xmlns:models="clr-namespace:MeiHuaPuChess.Core.Models;assembly=MeiHuaPuChess.Core"
        mc:Ignorable="d"
        Title="梅花谱象棋"
        Icon="Resources/app.ico"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F0EDE4">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:SideToColorConverter x:Key="SideToColor"/>

        <!-- 标题样式 -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3D2B1F"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 按钮样式 -->
        <Style x:Key="GameButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#5D3A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7B4F2C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B0A090"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 导航按钮（绿色系） -->
        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource GameButtonStyle}">
            <Setter Property="Background" Value="#4A6741"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A7D50"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#90A888"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 模式切换 ToggleButton 样式 -->
        <Style x:Key="ModeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#E8E0D0"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="8,0"
                                BorderBrush="#D0C8B8" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#5D3A1A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D8D0C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 走棋记录 ItemTemplate -->
        <DataTemplate x:Key="MoveItemTemplate" DataType="{x:Type models:MoveViewModel}">
            <Border Padding="4,2" CornerRadius="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentStep}" Value="True">
                                <Setter Property="Background" Value="#FFF9C4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="13" FontFamily="KaiTi, SimSun, Consolas">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding DisplayText}"/>
                            <Setter Property="Foreground" Value="#3D2B1F"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentStep}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#C41E3A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="560"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧：棋盘区域 ===== -->
        <Border Grid.Column="0" Margin="20" Background="#3D2B1F"
                CornerRadius="8" Padding="0">
            <Border Margin="12" Background="#F5DEB3" CornerRadius="4">
                <views:ChessBoardView x:Name="ChessBoard" Margin="8"
                                      IsReadOnly="{Binding IsBoardReadOnly}"/>
            </Border>
        </Border>

        <!-- ===== 右侧：控制面板 ===== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,20,20,20">

                <!-- ===== 模式切换 ===== -->
                <TextBlock Text="🎯 模式选择" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,12"
                        BorderBrush="#E0D8C8" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0" Content="📖 全局观看"
                                      IsChecked="{Binding IsReviewMode, Mode=OneWay}"
                                      Command="{Binding SwitchToReviewModeCommand}"
                                      Style="{StaticResource ModeToggleStyle}"
                                      Margin="0,0,4,0"/>
                        <ToggleButton Grid.Column="1" Content="🎮 训练模式"
                                      IsChecked="{Binding IsTrainingMode, Mode=OneWay}"
                                      Command="{Binding SwitchToTrainingModeCommand}"
                                      Style="{StaticResource ModeToggleStyle}"
                                      Margin="4,0,0,0"/>
                    </Grid>
                </Border>

                <!-- ===== 棋局选择 ===== -->
                <TextBlock Text="📋 棋局选择" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                        BorderBrush="#E0D8C8" BorderThickness="1">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding Records}"
                                  SelectedItem="{Binding SelectedRecord}"
                                  Height="36" FontSize="14"
                                  Background="#FAF7F0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Title}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding SelectedRecord.Description, TargetNullValue=''}"
                                   FontSize="12" Foreground="#888"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   MaxHeight="50" TextTrimming="CharacterEllipsis"/>

                        <!-- 开始按钮：根据模式显示不同文字和颜色 -->
                        <Button Margin="0,12,0,0" Style="{StaticResource GameButtonStyle}"
                                Background="#4A6741"
                                Command="{Binding StartReviewCommand}"
                                Visibility="{Binding IsReviewMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="15">▶ 开始观看</TextBlock>
                        </Button>
                        <Button Margin="0,12,0,0" Style="{StaticResource GameButtonStyle}"
                                Background="#8B0000"
                                Command="{Binding StartTrainingCommand}"
                                Visibility="{Binding IsTrainingMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="15">▶ 开始练习</TextBlock>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ===== 当前进度 ===== -->
                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                        BorderBrush="#E0D8C8" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="#3D2B1F" Margin="0,2,0,0"
                                   Text="{Binding StepProgress}"/>
                        <TextBlock FontSize="13" HorizontalAlignment="Center"
                                   Foreground="#888" Margin="0,4,0,0"
                                   Text="{Binding GameStatus}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="14" Foreground="#8B0000"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Text="{Binding CurrentSide}" Margin="0,4,0,0"/>
                        <!-- 训练完成提示 -->
                        <Border Background="#E8F5E9" CornerRadius="6" Padding="8,4" Margin="0,6,0,0"
                                Visibility="{Binding IsTrainingComplete, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="🎉 训练完成！切到『全局观看』回顾棋谱"
                                       FontSize="13" Foreground="#2E7D32"
                                       HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== Review 模式：导航按钮 ===== -->
                <StackPanel Visibility="{Binding IsReviewMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="🔍 棋谱导航" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                            BorderBrush="#E0D8C8" BorderThickness="1">
                        <StackPanel>
                            <!-- 第一行：最前/上一步/下一步/最后 -->
                            <UniformGrid Columns="4" Rows="1">
                                <Button Content="⏮" ToolTip="最前"
                                        Style="{StaticResource NavButtonStyle}"
                                        Command="{Binding GoToFirstCommand}"/>
                                <Button Content="◀" ToolTip="上一步"
                                        Style="{StaticResource NavButtonStyle}"
                                        Command="{Binding PreviousStepCommand}"
                                        IsEnabled="{Binding CanGoPrevious}"/>
                                <Button Content="▶" ToolTip="下一步"
                                        Style="{StaticResource NavButtonStyle}"
                                        Command="{Binding NextStepCommand}"
                                        IsEnabled="{Binding CanGoForward}"/>
                                <Button Content="⏭" ToolTip="最后"
                                        Style="{StaticResource NavButtonStyle}"
                                        Command="{Binding GoToLastCommand}"/>
                            </UniformGrid>

                            <!-- 第二行：自动播放 -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="{Binding AutoPlayButtonText}"
                                        Style="{StaticResource NavButtonStyle}"
                                        Command="{Binding ToggleAutoPlayCommand}"
                                        Width="120"/>
                                <TextBlock Text="速度(秒):"
                                           VerticalAlignment="Center" Margin="8,0,4,0"
                                           Foreground="#555" FontSize="13"/>
                                <TextBox Text="{Binding AutoPlaySpeed, UpdateSourceTrigger=PropertyChanged}"
                                         Width="45" Height="28" TextAlignment="Center"
                                         FontSize="13" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Training 模式：提示区域 ===== -->
                <StackPanel Visibility="{Binding IsTrainingMode, Converter={StaticResource BoolToVis}}">
                    <!-- 错误 / 提示信息 -->
                    <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                            BorderBrush="#E0D8C8" BorderThickness="1"
                            Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFF3CD"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHintError}" Value="True">
                                        <Setter Property="Background" Value="#FFE0E0"/>
                                        <Setter Property="BorderBrush" Value="#E57373"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHintError}" Value="False">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                        <Setter Property="BorderBrush" Value="#64B5F6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding HintMessage}"
                                   FontSize="13" TextWrapping="Wrap"
                                   Foreground="#333" FontWeight="SemiBold"/>
                    </Border>

                    <!-- 训练操作按钮 -->
                    <TextBlock Text="🎮 训练操作" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                            BorderBrush="#E0D8C8" BorderThickness="1">
                        <StackPanel>
                            <Button Content="🔄 重新开始" Style="{StaticResource GameButtonStyle}"
                                    Command="{Binding RestartCommand}" Background="#5D3A1A"
                                    Margin="0,0,0,6"/>
                            <Button Content="⏮ 悔棋" Style="{StaticResource GameButtonStyle}"
                                    Command="{Binding UndoCommand}" Background="#5D3A1A"
                                    IsEnabled="{Binding CanUndo}" Margin="0,0,0,6"/>
                            <Button Content="💡 显示提示" Style="{StaticResource GameButtonStyle}"
                                    Command="{Binding ShowHintCommand}"
                                    Background="#1565C0" Margin="0,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== 走棋记录（两种模式共用） ===== -->
                <TextBlock Text="📜 走棋记录" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,0"
                        BorderBrush="#E0D8C8" BorderThickness="1" MaxHeight="220">
                    <ListBox ItemsSource="{Binding MoveHistoryDisplay}"
                             ItemTemplate="{StaticResource MoveItemTemplate}"
                             Background="Transparent" BorderThickness="0"
                             FontSize="13" FontFamily="KaiTi, SimSun, Consolas">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== 底部状态栏 ===== -->
        <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom"
                Background="#3D2B1F" Padding="12,6" Height="32">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="#D0C0A0" FontSize="12" VerticalAlignment="Center">
                    <Run Text="{Binding CurrentSide, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="#D0C0A0" FontSize="12" Margin="30,0,0,0"
                           VerticalAlignment="Center">
                    <Run Text="红吃: "/><Run Text="{Binding CapturedByRed, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="#D0C0A0" FontSize="12" Margin="20,0,0,0"
                           VerticalAlignment="Center">
                    <Run Text="黑吃: "/><Run Text="{Binding CapturedByBlack, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
