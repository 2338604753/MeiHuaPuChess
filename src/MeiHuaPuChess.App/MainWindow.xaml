<Window x:Class="MeiHuaPuChess.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MeiHuaPuChess.App.Views"
        xmlns:converters="clr-namespace:MeiHuaPuChess.App.Converters"
        xmlns:models="clr-namespace:MeiHuaPuChess.Core.Models;assembly=MeiHuaPuChess.Core"
        mc:Ignorable="d"
        Title="梅花谱象棋"
        Icon="Resources/app.ico"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/IndigoJasmine.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <converters:SideToColorConverter x:Key="SideToColor"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A8A29E"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.08" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow" BlurRadius="4" ShadowDepth="1"
                          Direction="270" Opacity="0.15" Color="#000000"/>

        <!-- 卡片 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- 按钮模板 -->
        <ControlTemplate x:Key="BtnTemplate" TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    Effect="{StaticResource BtnShadow}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 各色按钮（独立定义，不用 BasedOn 以确保 DynamicResource 实时更新） -->
        <Style x:Key="IndigoButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
            <Setter Property="Background" Value="{DynamicResource IndigoBrush}"/>
        </Style>
        <Style x:Key="EmeraldButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
            <Setter Property="Background" Value="{DynamicResource EmeraldBrush}"/>
        </Style>
        <Style x:Key="RoseButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
            <Setter Property="Background" Value="{DynamicResource RoseBrush}"/>
        </Style>
        <Style x:Key="AmberButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
            <Setter Property="Background" Value="{DynamicResource AmberBrush}"/>
        </Style>
        <Style x:Key="SkyButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
            <Setter Property="Background" Value="{DynamicResource SkyBrush}"/>
        </Style>
        <Style x:Key="SlateButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
            <Setter Property="Background" Value="#78716C"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
        </Style>

        <!-- 模式 Toggle -->
        <Style x:Key="ReviewToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#78716C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" Background="#F5F5F4" CornerRadius="8,0,0,8" Padding="16,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="#D6D3D1"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource IndigoBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="dot" Property="Fill" Value="#A5B4FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrainToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#78716C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" Background="#F5F5F4" CornerRadius="0,8,8,0" Padding="16,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="#D6D3D1"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AmberBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="dot" Property="Fill" Value="#FDE68A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#FAFAF9"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Cursor="Hand">
                                            <Grid>
                                                <ContentPresenter Margin="12,0,30,0" VerticalAlignment="Center"
                                                                  Content="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBox}, Path=SelectionBoxItem}"/>
                                                <Path x:Name="arrow" Data="M0,0 L4,4 L8,0"
                                                      Stroke="#78716C" StrokeThickness="1.5"
                                                      HorizontalAlignment="Right" Margin="0,0,12,0"
                                                      Width="10" Height="6" Stretch="Fill"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" Focusable="False" PopupAnimation="Fade">
                                <Border Background="White" CornerRadius="10"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.12"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="320">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Padding" Value="14,0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="itemBorder" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,1">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="#F5F5F4"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="#ECFDF5"/>
                                            <Setter Property="Foreground" Value="{DynamicResource EmeraldBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 走棋记录 ItemTemplate -->
        <DataTemplate x:Key="MoveItemTemplate" DataType="{x:Type models:MoveViewModel}">
            <Border Padding="10,5" CornerRadius="6" Margin="0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentStep}" Value="True">
                                <Setter Property="Background" Value="#EEF2FF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F5F5F4"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentStep}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource IndigoBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StepNumber}" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#A8A29E"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentStep}" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Grid.Column="1" FontSize="13" FontFamily="KaiTi, SimSun, Consolas"
                               VerticalAlignment="Center" Text="{Binding DisplayText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentStep}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource IndigoBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="560"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧：棋盘 ===== -->
        <Border Grid.Column="0" Margin="16"
                Background="{DynamicResource BoardFrameBrush}" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25"/>
            </Border.Effect>
            <Border Margin="10" Background="#EED8B0" CornerRadius="6">
                <views:ChessBoardView x:Name="ChessBoard" Margin="6"
                                      IsReadOnly="{Binding IsBoardReadOnly}"/>
            </Border>
        </Border>

        <!-- ===== 右侧：控制面板 ===== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,16,20,20">
            <StackPanel>

                <!-- ===== 主题 + 更新 ===== -->
                <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="主题" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <Button x:Name="ThemeIndigo" Width="26" Height="26" Cursor="Hand"
                                    ToolTip="靛蓝茉莉" Click="OnThemeClick" Tag="IndigoJasmine"
                                    Style="{StaticResource IndigoButton}" Padding="0"
                                    Background="#4F46E5" Margin="0,0,5,0"/>
                            <Button x:Name="ThemeBamboo" Width="26" Height="26" Cursor="Hand"
                                    ToolTip="竹青翠微" Click="OnThemeClick" Tag="BambooGreen"
                                    Style="{StaticResource IndigoButton}" Padding="0"
                                    Background="#15803D" Margin="0,0,5,0"/>
                            <Button x:Name="ThemeCinnabar" Width="26" Height="26" Cursor="Hand"
                                    ToolTip="朱砂暖煦" Click="OnThemeClick" Tag="CinnabarWarm"
                                    Style="{StaticResource IndigoButton}" Padding="0"
                                    Background="#C2410C"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="检查更新" FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Center" Click="OnCheckUpdateClick"/>
                    </Grid>
                </Border>

                <!-- ========== 模式选择 ========== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource IndigoBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="模式选择" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="4">
                    <UniformGrid Columns="2" Rows="1">
                        <ToggleButton Content="全局观看"
                                      IsChecked="{Binding IsReviewMode, Mode=OneWay}"
                                      Command="{Binding SwitchToReviewModeCommand}"
                                      Style="{StaticResource ReviewToggle}"/>
                        <ToggleButton Content="训练模式"
                                      IsChecked="{Binding IsTrainingMode, Mode=OneWay}"
                                      Command="{Binding SwitchToTrainingModeCommand}"
                                      Style="{StaticResource TrainToggle}"/>
                    </UniformGrid>
                </Border>

                <!-- ========== 棋局选择 ========== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource EmeraldBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="棋局选择" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding Records}"
                                  SelectedItem="{Binding SelectedRecord}"
                                  Style="{StaticResource ModernComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#ECFDF5" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="12"
                                                       Foreground="{DynamicResource EmeraldBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding SelectedRecord.Description, TargetNullValue=''}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   MaxHeight="48" TextTrimming="CharacterEllipsis"/>

                        <Button Margin="0,14,0,0" Style="{StaticResource IndigoButton}"
                                Command="{Binding StartReviewCommand}"
                                Visibility="{Binding IsReviewMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="开始观看" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="0,14,0,0" Style="{StaticResource RoseButton}"
                                Command="{Binding StartTrainingCommand}"
                                Visibility="{Binding IsTrainingMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="开始练习" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ========== 当前进度 ========== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AmberBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="当前进度" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFBEB" Offset="0"/>
                            <GradientStop Color="#FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AmberBrush}" Margin="0,4,0,0"
                                   Text="{Binding StepProgress}"/>
                        <TextBlock FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                                   Text="{Binding GameStatus}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                        <Border Background="#FFF7ED" CornerRadius="8" Padding="8,4" Margin="0,8,0,0">
                            <TextBlock FontSize="14" Foreground="#C2410C"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Text="{Binding CurrentSide}"/>
                        </Border>
                        <Border Background="#ECFDF5" CornerRadius="8" Padding="10,6" Margin="0,8,0,0"
                                Visibility="{Binding IsTrainingComplete, Converter={StaticResource BoolToVis}}"
                                BorderBrush="#A7F3D0" BorderThickness="1">
                            <TextBlock Text="训练完成！切到「全局观看」回顾棋谱"
                                       FontSize="13" Foreground="#065F46"
                                       HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ========== 棋谱导航 ========== -->
                <StackPanel Visibility="{Binding IsReviewMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource VioletBrush}"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="棋谱导航" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <UniformGrid Columns="4" Rows="1">
                                <Button Content="⏮" ToolTip="最前" Style="{StaticResource NavBtn}"
                                        Background="{DynamicResource VioletBrush}"
                                        Command="{Binding GoToFirstCommand}"/>
                                <Button Content="◀" ToolTip="上一步" Style="{StaticResource NavBtn}"
                                        Background="{DynamicResource VioletBrush}"
                                        Command="{Binding PreviousStepCommand}"
                                        IsEnabled="{Binding CanGoPrevious}"/>
                                <Button Content="▶" ToolTip="下一步" Style="{StaticResource NavBtn}"
                                        Background="{DynamicResource VioletBrush}"
                                        Command="{Binding NextStepCommand}"
                                        IsEnabled="{Binding CanGoForward}"/>
                                <Button Content="⏭" ToolTip="最后" Style="{StaticResource NavBtn}"
                                        Background="{DynamicResource VioletBrush}"
                                        Command="{Binding GoToLastCommand}"/>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Button Content="{Binding AutoPlayButtonText}"
                                        Style="{StaticResource IndigoButton}"
                                        Command="{Binding ToggleAutoPlayCommand}"
                                        Width="100" Height="36" FontSize="13"/>
                                <TextBlock Text="速度(秒)" VerticalAlignment="Center" Margin="10,0,4,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBox Text="{Binding AutoPlaySpeed, UpdateSourceTrigger=PropertyChanged}"
                                         Width="44" Height="32" TextAlignment="Center"
                                         FontSize="13" VerticalContentAlignment="Center"
                                         BorderBrush="{DynamicResource CardBorderBrush}"
                                         Background="#FAFAF9" BorderThickness="1"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== 训练操作 ========== -->
                <StackPanel Visibility="{Binding IsTrainingMode, Converter={StaticResource BoolToVis}}">
                    <Border CornerRadius="12" Padding="14" Margin="0,0,0,14"
                            Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFFBEB"/>
                                <Setter Property="BorderBrush" Value="#FDE68A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHintError}" Value="True">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHintError}" Value="False">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="💡"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHintError}" Value="True">
                                                <Setter Property="Text" Value="✕"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding HintMessage}" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource RoseBrush}"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="训练操作" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Button Content="  重新开始" Style="{StaticResource SlateButton}"
                                    Command="{Binding RestartCommand}" Margin="0,0,0,6"/>
                            <Button Content="  悔棋" Style="{StaticResource AmberButton}"
                                    Command="{Binding UndoCommand}"
                                    IsEnabled="{Binding CanUndo}" Margin="0,0,0,6"/>
                            <Button Content="  显示提示" Style="{StaticResource SkyButton}"
                                    Command="{Binding ShowHintCommand}" Margin="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== 走棋记录 ========== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource TealBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="走棋记录" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="10" MaxHeight="200">
                    <ListBox ItemsSource="{Binding MoveHistoryDisplay}"
                             ItemTemplate="{StaticResource MoveItemTemplate}"
                             Background="Transparent" BorderThickness="0"
                             FontSize="13" FontFamily="KaiTi, SimSun, Consolas"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== 底部状态栏 ===== -->
        <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom"
                Background="{DynamicResource StatusBarBrush}" Padding="16,10" Height="40">
            <StackPanel Orientation="Horizontal">
                <Border Background="{DynamicResource IndigoBrush}" CornerRadius="4"
                        Padding="8,3" Margin="0,0,16,0">
                    <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold"
                               Text="{Binding CurrentSide, Mode=OneWay}"/>
                </Border>
                <Ellipse Width="4" Height="4" Fill="#DC2626" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Foreground="#A8A29E" FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Run Text="红吃 "/><Run Text="{Binding CapturedByRed, Mode=OneWay}" FontWeight="Bold" Foreground="#FCA5A5"/>
                </TextBlock>
                <Ellipse Width="4" Height="4" Fill="#57534E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Foreground="#A8A29E" FontSize="12" VerticalAlignment="Center">
                    <Run Text="黑吃 "/><Run Text="{Binding CapturedByBlack, Mode=OneWay}" FontWeight="Bold" Foreground="#D6D3D1"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
